{
  "rules": {
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "role": {
          ".validate": "root.child('users').child(auth.uid).child('role').val() === 'admin' || newData.val() === data.val() || (!data.exists() && newData.val() === 'citizen')"
        },
        "verified": {
          ".validate": "root.child('users').child(auth.uid).child('role').val() === 'admin' || newData.val() === data.val() || (!data.exists() && newData.val() === false)"
        },
        "is_active": {
          ".validate": "root.child('users').child(auth.uid).child('role').val() === 'admin' || newData.val() === data.val() || (!data.exists() && newData.val() === true)"
        },
        "is_frozen": {
          ".validate": "root.child('users').child(auth.uid).child('role').val() === 'admin' || newData.val() === data.val() || (!data.exists() && newData.val() === false)"
        }
      }
    },

    "card_types": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "applications": {
      ".read": "auth != null",
      ".indexOn": "citizen_id",
      "$id": {
        ".read": "auth != null && (data.child('citizen_id').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (!data.exists() && newData.child('citizen_id').val() === auth.uid))"
      }
    },

    "documents": {
      ".read": "auth != null",
      ".indexOn": "citizen_id",
      "$id": {
        ".read": "auth != null && (data.child('citizen_id').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (newData.child('citizen_id').val() === auth.uid && (!data.exists() || data.child('citizen_id').val() === auth.uid)))"
      }
    },

    "distributions": {
      ".read": "auth != null",
      ".indexOn": "citizen_id",
      "$id": {
        ".read": "auth != null && (data.child('citizen_id').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },

    "notifications": {
      ".read": "auth != null",
      ".indexOn": "citizen_id",
      "$id": {
        ".read": "auth != null && (data.child('citizen_id').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (data.exists() && data.child('citizen_id').val() === auth.uid && newData.child('citizen_id').val() === data.child('citizen_id').val() && newData.child('message').val() === data.child('message').val() && newData.child('created_at').val() === data.child('created_at').val()))",
        "citizen_id": { ".validate": "root.child('users').child(auth.uid).child('role').val() === 'admin' || newData.val() === data.val()" },
        "message": { ".validate": "root.child('users').child(auth.uid).child('role').val() === 'admin' || newData.val() === data.val()" },
        "created_at": { ".validate": "root.child('users').child(auth.uid).child('role').val() === 'admin' || newData.val() === data.val()" },
        "is_read": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": "root.child('users').child(auth.uid).child('role').val() === 'admin'" }
      }
    },

    "eligibility_requests": {
      ".read": "auth != null",
      ".indexOn": "citizen_id",
      "$id": {
        ".read": "auth != null && (data.child('citizen_id').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (!data.exists() && newData.child('citizen_id').val() === auth.uid))"
      }
    },

    "admin_notifications": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$id": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || !data.exists())"
      }
    }
  }
}
